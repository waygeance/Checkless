generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  HUMAN
  BOT
}

enum UserRole {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum GameVariant {
  ONE_SECOND
  THREE_SECONDS
  FIVE_SECONDS
}

enum GameMode {
  CASUAL
  RANKED
  CHALLENGE
  TOURNAMENT
}

enum GameStatus {
  ACTIVE
  COMPLETED
  ABORTED
  INTERRUPTED
}

enum GameOutcome {
  WIN
  LOSS
  NO_RESULT
}

enum GameEndReason {
  KING_CAPTURED
  DISCONNECT_FORFEIT
  RESIGNATION
  ABORTED
  SERVER_INTERRUPTED
  ADMIN_TERMINATED
}

enum ChessColor {
  WHITE
  BLACK
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum ChallengeStatus {
  OPEN
  ACCEPTED
  STARTED
  COMPLETED
  EXPIRED
  CANCELED
}

enum TournamentFormat {
  ROUND_ROBIN
  SWISS
}

enum TournamentAccess {
  PUBLIC
  CODE
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  ACTIVE
  COMPLETED
  CANCELED
}

enum TournamentParticipantStatus {
  REGISTERED
  ACTIVE
  WITHDRAWN
  DISQUALIFIED
  COMPLETED
}

enum TournamentRoundStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum TournamentPairingResult {
  PENDING
  WHITE_WIN
  BLACK_WIN
  BYE
  NO_RESULT
}

enum TournamentInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
}

model User {
  id                 String     @id @default(cuid())
  clerkUserId        String?    @unique
  username           String
  normalizedUsername String     @unique
  displayName        String?
  avatarUrl          String?
  kind               UserKind   @default(HUMAN)
  role               UserRole   @default(PLAYER)
  status             UserStatus @default(ACTIVE)
  suspensionReason   String?
  suspendedAt        DateTime?
  clerkDeletedAt     DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  botProfile                BotProfile?
  gameParticipants          GameParticipant[]
  variantStats              PlayerVariantStats[]
  sentFriendRequests        FriendRequest[]         @relation("FriendRequestSender")
  receivedFriendRequests    FriendRequest[]         @relation("FriendRequestReceiver")
  friendshipsAsUserA        Friendship[]            @relation("FriendshipUserA")
  friendshipsAsUserB        Friendship[]            @relation("FriendshipUserB")
  blocksCreated             UserBlock[]             @relation("Blocker")
  blocksReceived            UserBlock[]             @relation("Blocked")
  hostedChallenges          Challenge[]             @relation("ChallengeHost")
  receivedChallenges        Challenge[]             @relation("ChallengeOpponent")
  hostedTournaments         Tournament[]            @relation("TournamentHost")
  tournamentParticipations  TournamentParticipant[]
  sentTournamentInvites     TournamentInvite[]      @relation("TournamentInviteSender")
  receivedTournamentInvites TournamentInvite[]      @relation("TournamentInviteRecipient")
  adminActions              AdminAuditLog[]         @relation("AdminActor")
  moderationHistory         AdminAuditLog[]         @relation("AuditTargetUser")

  @@index([username])
  @@index([kind, status])
  @@index([lastSeenAt])
}

model GuestIdentity {
  id           String   @id @default(cuid())
  publicAlias  String
  tokenVersion Int      @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  gameParticipants GameParticipant[]

  @@index([lastSeenAt])
}

model BotProfile {
  userId        String   @id
  engineKey     String
  engineVersion String?
  difficulty    Int?
  enabled       Boolean  @default(false)
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id           String         @id @default(cuid())
  mode         GameMode
  variant      GameVariant
  status       GameStatus     @default(ACTIVE)
  rated        Boolean        @default(false)
  rulesVersion Int            @default(1)
  initialFen   String
  finalFen     String?
  winnerColor  ChessColor?
  endReason    GameEndReason?
  lastSequence Int            @default(0)
  createdAt    DateTime       @default(now())
  startedAt    DateTime       @default(now())
  endedAt      DateTime?

  participants      GameParticipant[]
  moves             GameMove[]
  challenge         Challenge?
  tournamentPairing TournamentPairing?
  auditLogs         AdminAuditLog[]

  @@index([status, startedAt])
  @@index([mode, variant, startedAt])
  @@index([endedAt])
}

model GameParticipant {
  id                  String      @id @default(cuid())
  gameId              String
  userId              String?
  guestIdentityId     String?
  color               ChessColor
  outcome             GameOutcome @default(NO_RESULT)
  usernameSnapshot    String
  displayNameSnapshot String?
  avatarUrlSnapshot   String?
  ratingBefore        Int?
  ratingAfter         Int?
  ratingDelta         Int?
  createdAt           DateTime    @default(now())

  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestIdentity GuestIdentity? @relation(fields: [guestIdentityId], references: [id], onDelete: SetNull)
  moves         GameMove[]

  @@unique([gameId, color])
  @@unique([gameId, userId])
  @@unique([gameId, guestIdentityId])
  @@index([userId, createdAt])
  @@index([guestIdentityId, createdAt])
}

model GameMove {
  id                   String     @id @default(cuid())
  gameId               String
  participantId        String
  sequence             Int
  clientMoveId         String?
  color                ChessColor
  fromSquare           String
  toSquare             String
  piece                String
  capturedPiece        String?
  promotionPiece       String?
  fenAfter             String
  elapsedMs            Int
  whiteCooldownMsAfter Int
  blackCooldownMsAfter Int
  acceptedAt           DateTime   @default(now())

  game        Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participant GameParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([gameId, sequence])
  @@unique([gameId, clientMoveId])
  @@index([participantId, acceptedAt])
}

model PlayerVariantStats {
  id           String      @id @default(cuid())
  userId       String
  variant      GameVariant
  rating       Int         @default(1200)
  totalGames   Int         @default(0)
  totalWins    Int         @default(0)
  totalLosses  Int         @default(0)
  rankedGames  Int         @default(0)
  rankedWins   Int         @default(0)
  rankedLosses Int         @default(0)
  lastPlayedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, variant])
  @@index([variant, rating])
}

model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  updatedAt   DateTime            @updatedAt

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Challenge {
  id          String          @id @default(cuid())
  code        String          @unique
  hostId      String
  opponentId  String?
  gameId      String?         @unique
  variant     GameVariant
  status      ChallengeStatus @default(OPEN)
  expiresAt   DateTime
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  host     User  @relation("ChallengeHost", fields: [hostId], references: [id], onDelete: Restrict)
  opponent User? @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  game     Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([hostId, status, createdAt])
  @@index([opponentId, status, createdAt])
  @@index([status, expiresAt])
}

model Tournament {
  id                   String           @id @default(cuid())
  hostId               String
  name                 String
  description          String?
  format               TournamentFormat
  access               TournamentAccess @default(PUBLIC)
  joinCode             String?          @unique
  status               TournamentStatus @default(DRAFT)
  variant              GameVariant
  rated                Boolean          @default(false)
  maxPlayers           Int
  roundCount           Int?
  currentRound         Int              @default(0)
  settings             Json?
  registrationClosesAt DateTime?
  startsAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  host         User                    @relation("TournamentHost", fields: [hostId], references: [id], onDelete: Restrict)
  participants TournamentParticipant[]
  rounds       TournamentRound[]
  invites      TournamentInvite[]

  @@index([status, access, createdAt])
  @@index([hostId, status, createdAt])
  @@index([startsAt])
}

model TournamentParticipant {
  id            String                      @id @default(cuid())
  tournamentId  String
  userId        String
  status        TournamentParticipantStatus @default(REGISTERED)
  seed          Int?
  score         Float                       @default(0)
  tieBreakScore Float                       @default(0)
  finalRank     Int?
  joinedAt      DateTime                    @default(now())
  withdrawnAt   DateTime?

  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  whitePairings TournamentPairing[] @relation("TournamentWhiteParticipant")
  blackPairings TournamentPairing[] @relation("TournamentBlackParticipant")

  @@unique([tournamentId, userId])
  @@unique([tournamentId, seed])
  @@index([tournamentId, score, tieBreakScore])
  @@index([userId, joinedAt])
}

model TournamentRound {
  id           String                @id @default(cuid())
  tournamentId String
  number       Int
  status       TournamentRoundStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime              @default(now())

  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pairings   TournamentPairing[]

  @@unique([tournamentId, number])
  @@index([tournamentId, status])
}

model TournamentPairing {
  id                 String                  @id @default(cuid())
  roundId            String
  whiteParticipantId String?
  blackParticipantId String?
  gameId             String?                 @unique
  boardNumber        Int
  result             TournamentPairingResult @default(PENDING)
  createdAt          DateTime                @default(now())
  completedAt        DateTime?

  round            TournamentRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  whiteParticipant TournamentParticipant? @relation("TournamentWhiteParticipant", fields: [whiteParticipantId], references: [id], onDelete: Restrict)
  blackParticipant TournamentParticipant? @relation("TournamentBlackParticipant", fields: [blackParticipantId], references: [id], onDelete: Restrict)
  game             Game?                  @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([roundId, boardNumber])
  @@index([whiteParticipantId])
  @@index([blackParticipantId])
}

model TournamentInvite {
  id           String                 @id @default(cuid())
  tournamentId String
  senderId     String
  recipientId  String
  status       TournamentInviteStatus @default(PENDING)
  expiresAt    DateTime?
  createdAt    DateTime               @default(now())
  respondedAt  DateTime?
  updatedAt    DateTime               @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sender     User       @relation("TournamentInviteSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient  User       @relation("TournamentInviteRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, recipientId])
  @@index([recipientId, status, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  targetGameId String?
  action       String
  reason       String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor      User  @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetGame Game? @relation(fields: [targetGameId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetGameId, createdAt])
}

model User {
  id                 String     @id @default(cuid())
  clerkUserId        String?    @unique
  username           String
  normalizedUsername String     @unique
  displayName        String?
  avatarUrl          String?
  kind               UserKind   @default(HUMAN)
  role               UserRole   @default(PLAYER)
  status             UserStatus @default(ACTIVE)
  suspensionReason   String?
  suspendedAt        DateTime?
  clerkDeletedAt     DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  botProfile                BotProfile?
  gameParticipants          GameParticipant[]
  variantStats              PlayerVariantStats[]
  sentFriendRequests        FriendRequest[]         @relation("FriendRequestSender")
  receivedFriendRequests    FriendRequest[]         @relation("FriendRequestReceiver")
  friendshipsAsUserA        Friendship[]            @relation("FriendshipUserA")
  friendshipsAsUserB        Friendship[]            @relation("FriendshipUserB")
  blocksCreated             UserBlock[]             @relation("Blocker")
  blocksReceived            UserBlock[]             @relation("Blocked")
  hostedChallenges          Challenge[]             @relation("ChallengeHost")
  receivedChallenges        Challenge[]             @relation("ChallengeOpponent")
  hostedTournaments         Tournament[]            @relation("TournamentHost")
  tournamentParticipations  TournamentParticipant[]
  sentTournamentInvites     TournamentInvite[]      @relation("TournamentInviteSender")
  receivedTournamentInvites TournamentInvite[]      @relation("TournamentInviteRecipient")
  adminActions              AdminAuditLog[]         @relation("AdminActor")
  moderationHistory         AdminAuditLog[]         @relation("AuditTargetUser")

  @@index([username])
  @@index([kind, status])
  @@index([lastSeenAt])
}

model GuestIdentity {
  id           String   @id @default(cuid())
  publicAlias  String
  tokenVersion Int      @default(1)
  firstSeenAt  DateTime @default(now())
  /// Auto-updated on every row change — reflects last connection time.
  lastSeenAt   DateTime @updatedAt

  gameParticipants GameParticipant[]

  @@index([lastSeenAt])
}

model BotProfile {
  userId        String   @id
  engineKey     String
  engineVersion String?
  difficulty    Int?
  /// When false, this bot is excluded from matchmaking queues.
  enabled       Boolean  @default(false)
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
